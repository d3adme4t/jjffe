# Phase 62-03 / 62-04a: TST-04 fixed-point / matrix / PRNG vs ASM-transcribed goldens
add_executable(test_golden_record_math test/test_golden_record_math.cpp)
target_link_libraries(test_golden_record_math "LINKER:--start-group" jjffe_game jjffe_platform jjffe_core jjffe_data "LINKER:--end-group")
add_test(NAME GoldenRecordFixedMul COMMAND test_golden_record_math fixed_mul)
add_test(NAME GoldenRecordSpecialDiv COMMAND test_golden_record_math special_div)
add_test(NAME GoldenRecordMatMul COMMAND test_golden_record_math mat_mul)
add_test(NAME GoldenRecordPRNG COMMAND test_golden_record_math prng)
# 62-04a: 5 seeds × {1e6, 1e7} — one CTest per cell + aggregate
set(_PRNG_MATRIX_SEEDS 0x00000001 0xDEADBEEF 0x00000000 0x12345678 0xFFFFFFFF)
set(_PRNG_MATRIX_LENS 1000000 10000000)
foreach(_seed IN LISTS _PRNG_MATRIX_SEEDS)
  foreach(_len IN LISTS _PRNG_MATRIX_LENS)
    # Strip 0x for a stable CTest name token
    string(REGEX REPLACE "^0[xX]" "" _seed_tok "${_seed}")
    add_test(NAME GoldenRecordPRNG_${_seed_tok}_${_len}
             COMMAND test_golden_record_math prng ${_seed} ${_len})
    list(APPEND _PRNG_MATRIX_TESTS GoldenRecordPRNG_${_seed_tok}_${_len})
  endforeach()
endforeach()
add_test(NAME GoldenRecordPRNGMatrix COMMAND test_golden_record_math prng_matrix)
set_tests_properties(
  GoldenRecordFixedMul GoldenRecordSpecialDiv GoldenRecordMatMul GoldenRecordPRNG
  GoldenRecordPRNGMatrix ${_PRNG_MATRIX_TESTS}
  PROPERTIES WORKING_DIRECTORY ${CMAKE_SOURCE_DIR})

