# Task 4.48: the deterministic logic replay. test_logic_replay runs the scenario with
# time / RNG / input pinned and dumps RNG draws + per-label checkpoints;
# tools/logic_state_diff.py compares them with the ffeasm recording
# (test/data/logic_replay/, tools/capture_asm_replay.sh) against the ratchet baseline.
add_executable(test_logic_replay test/test_logic_replay.cpp)
target_link_libraries(test_logic_replay "LINKER:--start-group" jjffe_game jjffe_platform jjffe_core jjffe_data "LINKER:--end-group" ${CMAKE_DL_LIBS})
target_compile_definitions(test_logic_replay PRIVATE JJFFE_SOURCE_DIR="${CMAKE_SOURCE_DIR}")
# Task 4.49: the same harness in a flat 32-bit address space like the ASM's
# (non-PIE, brk-only malloc, a MAP_32BIT stack), so the port's 32-bit copies of
# pointers (FUNC_001538's ship models, int32_t stack-buffer parameters) stay
# valid on the station-services path; the PIE build faults there
# (docs/FLIGHT_SCENE_GAP.md 4.49). newgame_accel stays on the PIE build.
add_executable(test_logic_replay_lowmem test/test_logic_replay.cpp)
target_link_libraries(test_logic_replay_lowmem "LINKER:--start-group" jjffe_game jjffe_platform jjffe_core jjffe_data "LINKER:--end-group" ${CMAKE_DL_LIBS})
target_compile_definitions(test_logic_replay_lowmem PRIVATE JJFFE_SOURCE_DIR="${CMAKE_SOURCE_DIR}"
                           JJFFE_REPLAY_LOWMEM=1)
# The image at 0x60000000 rather than 0x400000, so 16.16 values such as 0x460000
# are not taken for code addresses when the port golden is canonicalised.
# Task 4.145: the runtime arenas (the object pool, the DATA_008804 span and four
# tables) sit at ffeasm's addresses for their labels (JjffeAsmArenaPlace in the test).
target_link_options(test_logic_replay_lowmem PRIVATE -no-pie -Wl,-Ttext-segment=0x60000000)
add_test(NAME LogicReplay
  COMMAND ${CMAKE_COMMAND} -E env python3 ${CMAKE_SOURCE_DIR}/tools/logic_state_diff.py ctest
          --bin $<TARGET_FILE:test_logic_replay> --out ${CMAKE_BINARY_DIR}/logic_replay)
set_tests_properties(LogicReplay PROPERTIES WORKING_DIRECTORY ${CMAKE_SOURCE_DIR})
# Task 4.49: scripted scenarios (test/data/logic_replay/<name>/scenario.json,
# recorded by REPLAY_SCENARIO=<name> tools/capture_asm_replay.sh).
foreach(_scen mission_accept:LogicReplayMission combat:LogicReplayCombat dock_launch:LogicReplayDock
              services_launch:LogicReplayServices services_tour:LogicReplayTour
              services_every:LogicReplayEvery traffic_ai:LogicReplayTraffic
              player_crash:LogicReplayCrash services_slots:LogicReplaySlots
              targeting:LogicReplayTargeting hyperjump:LogicReplayHyperjump
              military_board:LogicReplayMilitary status_screens:LogicReplayStatus
              asteroids:LogicReplayAsteroids missiles:LogicReplayMissiles)
  string(REPLACE ":" ";" _pair ${_scen})
  list(GET _pair 0 _name)
  list(GET _pair 1 _test)
  add_test(NAME ${_test}
    COMMAND ${CMAKE_COMMAND} -E env python3 ${CMAKE_SOURCE_DIR}/tools/logic_state_diff.py ctest
            --scenario ${_name} --bin $<TARGET_FILE:test_logic_replay_lowmem>
            --out ${CMAKE_BINARY_DIR}/logic_replay_${_name})
  set_tests_properties(${_test} PROPERTIES WORKING_DIRECTORY ${CMAKE_SOURCE_DIR})
endforeach()
# Task 4.114: the same fifteen scenarios on the PIE binary that ships, where a
# pointer cut to 32 bits faults or reads garbage (docs/PIE_GATE_GAP.md). Each
# checks its own PIE self-golden (--pie: <name>/port_*_pie.txt.gz,
# baseline_pie.txt) against the shared ASM golden. The output directories are
# distinct: captures/4.89/ratchet.py and pin read build/logic_replay_<name>.
set(_PIE_REPLAY_TESTS)
foreach(_scen mission_accept:Mission combat:Combat dock_launch:Dock services_launch:Services
              services_tour:Tour services_every:Every traffic_ai:Traffic player_crash:Crash
              services_slots:Slots targeting:Targeting hyperjump:Hyperjump military_board:Military
              status_screens:Status asteroids:Asteroids missiles:Missiles)
  string(REPLACE ":" ";" _pair ${_scen})
  list(GET _pair 0 _name)
  list(GET _pair 1 _test)
  add_test(NAME PieLogicReplay${_test}
    COMMAND ${CMAKE_COMMAND} -E env python3 ${CMAKE_SOURCE_DIR}/tools/logic_state_diff.py ctest
            --pie --scenario ${_name} --bin $<TARGET_FILE:test_logic_replay>
            --out ${CMAKE_BINARY_DIR}/logic_replay_pie_${_name})
  set_tests_properties(PieLogicReplay${_test} PROPERTIES WORKING_DIRECTORY ${CMAKE_SOURCE_DIR})
  list(APPEND _PIE_REPLAY_TESTS PieLogicReplay${_test})
endforeach()

# Task 4.128: the ASM call oracle - logic-band functions no replay reaches,
# called on the port and compared with the same call recorded on ffeasm
# (test/data/asm_call_oracle/golden.txt, tools/capture_asm_call_oracle.sh).
# Built PIE and lowmem like the replays.
foreach(_v "test_asm_call_oracle:AsmCallOracle:0" "test_asm_call_oracle_lowmem:AsmCallOracleLowmem:1")
  string(REPLACE ":" ";" _parts ${_v})
  list(GET _parts 0 _exe)
  list(GET _parts 1 _test)
  list(GET _parts 2 _low)
  add_executable(${_exe} test/test_asm_call_oracle.cpp)
  target_link_libraries(${_exe} "LINKER:--start-group" jjffe_game jjffe_platform jjffe_core jjffe_data "LINKER:--end-group" ${CMAKE_DL_LIBS})
  target_compile_definitions(${_exe} PRIVATE JJFFE_SOURCE_DIR="${CMAKE_SOURCE_DIR}")
  if(_low)
    target_compile_definitions(${_exe} PRIVATE JJFFE_REPLAY_LOWMEM=1)
    target_link_options(${_exe} PRIVATE -no-pie -Wl,-Ttext-segment=0x60000000)
  endif()
  add_test(NAME ${_test} COMMAND ${_exe})
  set_tests_properties(${_test} PROPERTIES WORKING_DIRECTORY ${CMAKE_SOURCE_DIR})
endforeach()

