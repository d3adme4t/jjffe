set_tests_properties(InputPressWindow PROPERTIES ENVIRONMENT "BIN=$<TARGET_FILE:test_input_press_window>")
set_tests_properties(ViewModeCamera PROPERTIES WORKING_DIRECTORY ${CMAKE_SOURCE_DIR})

