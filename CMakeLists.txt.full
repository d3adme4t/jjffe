# Task 4.45 oracle classes, read by tools/oracle_coverage.py (`ctest -L asm_oracle`).
# asm_oracle: some assertion compares against data recorded by running ffeasm
#   (captures/, test/data/golden/* with "oracle": "ffeasm", GDB dumps, values
#   copied from such a recording). Code executed under these is "gate-executed".
# asm_transcribed: expectations read off ffe.asm / ffedat.asm, or a Python /
#   Ghidra re-implementation of them, not a recorded run.
# Every other test is self-referential (invariants, self-goldens, censuses).
# AbDiffSaker and AbStrictSakerAdder compare against ffeasm dumps but soft-pass
# any mismatch unless JJFFE_AB_STRICT=1, so they cannot fail and are not gates.
# R1141: their reference dumps (ab_shots/asm/, ab_shots/strict/<name>/asm/) are not
# committed, so with a missing reference they exit 77 and ctest reports them as
# "Not Run (Skipped)" - counted as neither a pass nor a failure. Record the dumps
# and they run as real gates again.
set_tests_properties(
  ModuleRegistry PlayerSpawnTests WorldParityTests WorldSpawnTable GameClock
  Planet0x1F Op1eSentinelCompose AbDPal
  GoldenRecordShipDemo ${_GOLDEN_SHIP_TESTS} FlightFrameAB ViewModeAB MissileViewReach HudRangeReach ParentRotationAB IntroCastColour
  TerrainColourOracle TerrainHazeDepth WaterHazeOracle WaterFaceCensus PadCityColour
  BootFlow UnitsAudit ConsoleGauge ConsoleButtons
  GoldenRecordBytecode ObjectSetupScaffold LogicReplay
  LogicReplayMission LogicReplayCombat LogicReplayDock LogicReplayServices LogicReplayTour
  LogicReplayEvery LogicReplayTraffic LogicReplayCrash LogicReplaySlots LogicReplayTargeting
  LogicReplayHyperjump LogicReplayMilitary LogicReplayStatus LogicReplayAsteroids
  LogicReplayMissiles ${_PIE_REPLAY_TESTS} AsmCallOracle AsmCallOracleLowmem
  PROPERTIES LABELS asm_oracle)
set_tests_properties(
  GoldenRecordFixedMul GoldenRecordSpecialDiv GoldenRecordMatMul GoldenRecordPRNG
  GoldenRecordPRNGMatrix ${_PRNG_MATRIX_TESTS}
  AbProjectionZoom VideoTests GuiPointers ConsoleLogFlag SysGenTests AbRasterFlat
  PROPERTIES LABELS asm_transcribed)
