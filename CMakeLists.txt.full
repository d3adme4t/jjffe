# R1174 InputPressWindow: a PHYSICAL key press (the edge is discovered inside the poll, as sdl_input.cpp
# does), asserting ffeasm's model - the effect lands one frame after the poll, early or late in the frame.
# This is the gate that can see R1173's defect; every injected-key gate is blind to it.
add_executable(test_input_press_window test/test_input_press_window.cpp)
target_link_libraries(test_input_press_window "LINKER:--start-group" jjffe_game jjffe_platform jjffe_core jjffe_data "LINKER:--end-group")
