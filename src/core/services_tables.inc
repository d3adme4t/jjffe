static const char DATA_002183[46] = "Jan will be waiting for you at [MiR(spy date)";  // ffedat.asm:1718-1719
static const char DATA_002184[29] = "\"Is this mission dangerous\077\"";  // ffedat.asm:1720-1721
static const char DATA_002185[47] = "Possibly.  Nothing you can't handle, I'm sure.";  // ffedat.asm:1722-1723
static const char DATA_002186[24] = "\"How much is it worth\077\"";  // ffedat.asm:1724-1725
static const char DATA_002187[16] = "$[MiR(spy cash)";  // ffedat.asm:1726-1727
static const char DATA_002188[36] = "\"I'd like half the money up front.\"";  // ffedat.asm:1728-1729
static const char DATA_002189[47] = "Sure you would.  You're not getting it though.";  // ffedat.asm:1730-1731
static const char DATA_002190[85] = "\"OK, that seems fair.  You'll get half on acceptance and half when you deliver Jan.\"";  // ffedat.asm:1732-1733
static const char DATA_002191[28] = "\"I want all the money now.\"";  // ffedat.asm:1734-1735
static const char DATA_002192[20] = "Dream on, sunshine.";  // ffedat.asm:1736-1737
static const char DATA_002193[16] = "\"OK, I accept.\"";  // ffedat.asm:1738-1739
static const char DATA_002194[53] = "Thank you.  Jan will be waiting for you.  Good luck.";  // ffedat.asm:1740-1741
static const char DATA_002195[89] = "Well done\\ Commander. You have rendered a valuable service.  You will not go unrewarded.";  // ffedat.asm:1742-1743
static const char DATA_002196[169] = "Commander.  You have failed in the mission to rescue Jan Thikka.  We were  required to send someone else and the mission was doubly dangerous.  We will not forget this.";  // ffedat.asm:1744-1745
static const char DATA_002197[140] = "Pick up Jan Thikka from Camp Campbell in Mairgre system (-8,-3) on [MiR(spy date), then  deliver her to any Federal System. $[MiR(spy cash)";  // ffedat.asm:1746-1747
static const char DATA_002198[59] = "Drop Jan Thikka off at any Federal system. $[MiR(spy cash)";  // ffedat.asm:1748-1749
static const char DATA_002199[96] = "INVALUABLE ARTWORK required to be transported to Beta Hydri.  Good price paid for safe transit.";  // ffedat.asm:1750-1751
static const char DATA_002200[137] = "The Duval Artefact statue has been bought from the Empire.  Please collect  it and take it to Beta Hydri.  We will pay $[MiR(statb cash)";  // ffedat.asm:1752-1753
static const char DATA_002201[23] = "\"Where is the statue\077\"";  // ffedat.asm:1754-1755
