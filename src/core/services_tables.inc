static const char DATA_002206[74] = "Please deliver immediately to Scott Town on Homeland in Beta Hydri (0,-2)";  // ffedat.asm:1764-1765
static const char DATA_002207[29] = "\"I want half the money now.\"";  // ffedat.asm:1766-1767
static const char DATA_002208[21] = "No chance, sunshine.";  // ffedat.asm:1768-1769
static const char DATA_002209[28] = "\"I want all the money now.\"";  // ffedat.asm:1770-1771
static const char DATA_002210[96] = "Do you really believe we're that stupid\077  You get the cash when we get the statue.  Not before.";  // ffedat.asm:1772-1773
static const char DATA_002211[115] = "Well done Commander.  You have done better than we'd hoped.  We will  keep your name on file for future reference.";  // ffedat.asm:1774-1775
